# Depots de reference clones pour analyse (mcpfabric, minecraft-mcp) : pas versionnes
reference/

# Gradle / Java
mod/.gradle/
mod/build/
mod/run/
mod/bin/
# Journaux ecrits par les taches Gradle (le mod journalise via slf4j des les tests)
mod/logs/
mod/.idea/
*.iml
*.class

# Node
mcp-server/node_modules/
mcp-server/dist/

# Le plugin embarque deux artefacts generes, volontairement versionnes : un plugin Claude Code est
# copie tel quel, sans etape de build ni npm install. scripts/build-plugin.sh les reconstruit.
!plugins/mcbridge/server/mcbridge-mcp.mjs
!plugins/mcbridge/mod/*.jar

# Divers
.DS_Store
*.log
